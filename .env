# Copy to .env next to deploy-aio-ai.sh and edit.
APP_DIR=app
PROJECT_NAME=ai_gui
COMPOSE_FILE=docker-compose.yml

REGISTRY=local
IMAGE_TAG=latest
APP_IMAGE=ai-gui-app
BACKEND_PORT=4401
APP_PORT=8090
LOG_LEVEL=info
SELF_HEAL_DB=no

# managed = compose also runs its own postgres (profile: managed-db)
# external = connect to a postgres you already run elsewhere
POSTGRES_MODE=external
POSTGRES_PORT=5432
POSTGRES_DB=ai_gui
POSTGRES_USER=opentts
POSTGRES_PASSWORD=e89ef1bcc9313fea7f9ae788ec38e9285787d3dddd98d21b165cdd1f7c6d8d64

# Connection details the app container actually uses. For POSTGRES_MODE=managed
# leave PGHOST=postgres (the compose service name). For POSTGRES_MODE=external
# point these at your existing database instead, e.g.:
#   PGHOST=192.168.0.140
#   PGPORT=8063
#   PGDATABASE=ai_gui
#   PGUSER=opentts
#   PGPASSWORD=<real password>
PGHOST=192.168.0.140
PGPORT=8063
PGDATABASE=ai_gui
PGUSER=opentts
PGPASSWORD=e89ef1bcc9313fea7f9ae788ec38e9285787d3dddd98d21b165cdd1f7c6d8d64

GATEWAY_HOST=192.168.0.140
DAY3_URL=http://192.168.0.140:4405
DAY4_URL=http://192.168.0.140:4406
DAY5_URL=http://192.168.0.140:4407
DAY6_URL=http://192.168.0.140:4408

TEST_HOST=192.168.0.140
TEST_RETRIES=20
TEST_RETRY_DELAY=3

CONVERSATION_CONTEXT_LIMIT=20
